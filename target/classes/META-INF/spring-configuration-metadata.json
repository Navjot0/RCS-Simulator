      "name": "operator.callback-url",
      "type": "java.lang.String",
      "description": "Where every DLR\/dispatch webhook is sent by default. A request can still override this per-message via {@code SendMessageRequest.callbackUrl} - this is just what's used when a request doesn't set one.",
