# Maven build output - was previously committed with no .gitignore in place
# at all, which is why the server ended up running stale/orphaned compiled
# test classes out of target/test-classes (the 119-vs-107 test count
# mismatch diagnosed earlier). `mvn clean` regenerates this directory from
# source every time - it should never be committed.
target/

# IDE project files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS noise
.DS_Store
Thumbs.db

# Logs generated by local runs (e.g. -Xlog:gc* output)
logs/
*.log
